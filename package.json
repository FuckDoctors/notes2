{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "package-manager-strict": false,
  "scripts": {
    "build": "pnpm docs:build",
    "dev": "pnpm docs:dev",
    "clean-dev": "pnpm docs:clean-dev",
    "lint": "eslint --cache .",
    "lint:antfu": "eslint --cache .",
    "lint:antfu-fix": "eslint --cache . --fix",
    "lint:types": "vue-tsc --noEmit --skipLibCheck",
    "lint:css": "stylelint --cache --fix \"**/*.{css,scss,vue}\" --allow-empty-input",
    "lint:js": "eslint --cache --fix \"**/*.{js,ts,vue,jsx,tsx}\"",
    "lint:md": "markdownlint --fix \"**/*.md\"",
    "lint:remark": "remark .",
    "lint:textlint": "textlint --fix",
    "lint:format": "prettier --write \"**/*.{js,ts,json,css,scss,vue,html,md}\"",
    "lint:all": "pnpm lint:css && pnpm lint:js && pnpm lint:md && pnpm lint:remark && pnpm lint:format",
    "up": "taze major -I",
    "prepare": "husky",
    "cm": "cz",
    "docs:build": "vuepress-vite build docs",
    "docs:build-ex": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vuepress-vite build docs",
    "docs:clean-dev": "vuepress-vite dev docs --clean-cache",
    "docs:dev": "vuepress-vite dev docs",
    "docs:update": "pnpm dlx vp-update",
    "test": "vitest",
    "sizecheck": "cross-env SIZE_CHECK=true pnpm docs:build"
  },
  "dependencies": {
    "cnchar": "^3.2.6",
    "cnchar-draw": "^3.2.6",
    "cnchar-explain": "^3.2.6",
    "cnchar-idiom": "^3.2.6",
    "cnchar-order": "^3.2.6",
    "cnchar-radical": "^3.2.6",
    "cnchar-voice": "^3.2.6",
    "cnchar-words": "^3.2.6",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@mathjax/src": "^4.1.3",
    "@textlint/ast-node-types": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "@types/postcss-import": "^14.0.3",
    "@unocss/eslint-config": "^66.10.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/repl": "^4.7.2",
    "@vue/test-utils": "^2.5.1",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/bundler-webpack": "2.0.0-rc.31",
    "@vuepress/plugin-clarity-analytics": "2.0.0-rc.135",
    "@vuepress/plugin-comment": "2.0.0-rc.137",
    "@vuepress/plugin-docsearch": "2.0.0-rc.137",
    "@vuepress/plugin-feed": "2.0.0-rc.137",
    "@vuepress/plugin-links-check": "2.0.0-rc.135",
    "@vuepress/plugin-llms": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-hint": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-image": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-math": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-tab": "2.0.0-rc.137",
    "@vuepress/plugin-pwa": "2.0.0-rc.137",
    "@vuepress/plugin-revealjs": "2.0.0-rc.137",
    "@vuepress/plugin-seo": "2.0.0-rc.137",
    "@vuepress/plugin-shiki": "2.0.0-rc.137",
    "@vuepress/plugin-sitemap": "2.0.0-rc.137",
    "@vuepress/plugin-watermark": "2.0.0-rc.135",
    "@vuepress/shiki-twoslash": "2.0.0-rc.135",
    "@waline/client": "^3.16.0",
    "autoprefixer": "^10.6.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^18.0.6",
    "echarts": "^6.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-format": "^2.0.1",
    "flowchart.ts": "^3.0.1",
    "husky": "^9.1.7",
    "katex": "^0.19.0",
    "lint-staged": "^17.6.0",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdownlint": "^0.41.1",
    "markdownlint-cli": "^0.49.1",
    "markmap-lib": "^0.18.12",
    "markmap-toolbar": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^12.1.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "postcss-import": "^17.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-toc": "^9.0.0",
    "remark-validate-links": "^13.1.0",
    "reveal.js": "^6.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sandpack-vue3": "^3.1.12",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-hudochenkov": "^13.0.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.3.0",
    "taze": "^21.3.0",
    "textlint": "^15.8.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-no-todo": "^2.0.1",
    "textlint-rule-rousseau": "^1.4.8",
    "textlint-rule-unexpanded-acronym": "^1.2.4",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.110"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "react",
        "react-dom",
        "@types/react",
        "webpack"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
